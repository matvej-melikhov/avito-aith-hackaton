{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:review-platform:command:1.1.0",
  "x-contract-status": "frozen",
  "title": "CommandContracts",
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "empty_payload": {"type": "object", "additionalProperties": false, "properties": {}},
    "command_core": {
      "type": "object",
      "required": ["request_id", "idempotency_key", "command_name", "revision_target", "target_id", "expected_revision", "payload"],
      "properties": {
        "request_id": {"$ref": "#/$defs/uuid"},
        "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 128},
        "command_name": {"enum": ["activate_bootstrap", "create_invitation", "revoke_invitation", "start_course_import", "archive_course", "restore_course", "archive_course_run", "restore_course_run", "change_membership_roles", "create_homework", "create_homework_version", "publish_homework_version", "set_reviewer_course_selection", "set_reviewer_availability", "preflight_submission", "submit_work", "open_review_iteration", "migrate_review_requirements", "create_review_correction", "record_review_responsibility", "save_review_revision", "request_review_publication", "publish_review", "start_ai_review", "retry_delivery", "grant_agent_authorization", "revoke_agent_authorization", "recover_methodologist"]},
        "revision_target": {"enum": ["organization", "membership", "invitation", "course", "course_run", "course_run_homework", "homework", "homework_version", "submission", "review_case", "review_iteration", "publication_request", "external_delivery", "agent_authorization"]},
        "target_id": {"$ref": "#/$defs/uuid"},
        "expected_revision": {"type": "integer", "minimum": 0},
        "payload": {"type": "object"}
      }
    },
    "command_variant": {
      "oneOf": [
        {"properties": {"command_name": {"const": "activate_bootstrap"}, "revision_target": {"const": "organization"}, "payload": {"$ref": "#/$defs/activate_bootstrap_payload"}}},
        {"properties": {"command_name": {"const": "create_invitation"}, "revision_target": {"const": "organization"}, "payload": {"$ref": "#/$defs/create_invitation_payload"}}},
        {"properties": {"command_name": {"const": "revoke_invitation"}, "revision_target": {"const": "invitation"}, "payload": {"$ref": "#/$defs/reason_payload"}}},
        {"properties": {"command_name": {"const": "start_course_import"}, "revision_target": {"const": "organization"}, "payload": {"$ref": "#/$defs/start_course_import_payload"}}},
        {"properties": {"command_name": {"const": "archive_course"}, "revision_target": {"const": "course"}, "payload": {"$ref": "#/$defs/reason_payload"}}},
        {"properties": {"command_name": {"const": "restore_course"}, "revision_target": {"const": "course"}, "payload": {"$ref": "#/$defs/empty_payload"}}},
        {"properties": {"command_name": {"const": "archive_course_run"}, "revision_target": {"const": "course_run"}, "payload": {"$ref": "#/$defs/reason_payload"}}},
        {"properties": {"command_name": {"const": "restore_course_run"}, "revision_target": {"const": "course_run"}, "payload": {"$ref": "#/$defs/empty_payload"}}},
        {"properties": {"command_name": {"const": "change_membership_roles"}, "revision_target": {"const": "membership"}, "payload": {"$ref": "#/$defs/change_membership_roles_payload"}}},
        {"properties": {"command_name": {"const": "create_homework"}, "revision_target": {"const": "course_run"}, "payload": {"$ref": "#/$defs/create_homework_payload"}}},
        {"properties": {"command_name": {"const": "create_homework_version"}, "revision_target": {"const": "homework"}, "payload": {"$ref": "#/$defs/create_homework_version_payload"}}},
        {"properties": {"command_name": {"const": "publish_homework_version"}, "revision_target": {"const": "homework_version"}, "payload": {"$ref": "#/$defs/publish_homework_version_payload"}}},
        {"properties": {"command_name": {"const": "set_reviewer_course_selection"}, "revision_target": {"const": "membership"}, "payload": {"$ref": "#/$defs/set_reviewer_course_selection_payload"}}},
        {"properties": {"command_name": {"const": "set_reviewer_availability"}, "revision_target": {"const": "membership"}, "payload": {"$ref": "#/$defs/set_reviewer_availability_payload"}}},
        {"properties": {"command_name": {"const": "preflight_submission"}, "revision_target": {"const": "course_run_homework"}, "payload": {"$ref": "#/$defs/preflight_submission_payload"}}},
        {"properties": {"command_name": {"const": "submit_work"}, "revision_target": {"const": "submission"}, "payload": {"$ref": "#/$defs/submit_work_payload"}}},
        {"properties": {"command_name": {"const": "open_review_iteration"}, "revision_target": {"const": "review_case"}, "payload": {"$ref": "#/$defs/open_review_iteration_payload"}}},
        {"properties": {"command_name": {"const": "migrate_review_requirements"}, "revision_target": {"const": "review_iteration"}, "payload": {"$ref": "#/$defs/migrate_review_requirements_payload"}}},
        {"properties": {"command_name": {"const": "create_review_correction"}, "revision_target": {"const": "review_iteration"}, "payload": {"$ref": "#/$defs/create_review_correction_payload"}}},
        {"properties": {"command_name": {"const": "record_review_responsibility"}, "revision_target": {"const": "review_iteration"}, "payload": {"$ref": "#/$defs/record_review_responsibility_payload"}}},
        {"properties": {"command_name": {"const": "save_review_revision"}, "revision_target": {"const": "review_iteration"}, "payload": {"$ref": "#/$defs/save_review_revision_payload"}}},
        {"properties": {"command_name": {"const": "request_review_publication"}, "revision_target": {"const": "review_iteration"}, "payload": {"$ref": "#/$defs/request_review_publication_payload"}}},
        {"properties": {"command_name": {"const": "publish_review"}, "revision_target": {"const": "review_iteration"}, "payload": {"$ref": "#/$defs/publish_review_payload"}}},
        {"properties": {"command_name": {"const": "start_ai_review"}, "revision_target": {"const": "review_iteration"}, "payload": {"$ref": "#/$defs/empty_payload"}}},
        {"properties": {"command_name": {"const": "retry_delivery"}, "revision_target": {"const": "external_delivery"}, "payload": {"$ref": "#/$defs/retry_delivery_payload"}}},
        {"properties": {"command_name": {"const": "grant_agent_authorization"}, "revision_target": {"const": "membership"}, "payload": {"$ref": "#/$defs/grant_agent_authorization_payload"}}},
        {"properties": {"command_name": {"const": "revoke_agent_authorization"}, "revision_target": {"const": "agent_authorization"}, "payload": {"$ref": "#/$defs/reason_payload"}}},
        {"properties": {"command_name": {"const": "recover_methodologist"}, "revision_target": {"const": "organization"}, "payload": {"$ref": "#/$defs/recover_methodologist_payload"}}}
      ]
    },
    "wire": {"allOf": [{"$ref": "#/$defs/command_core"}, {"$ref": "#/$defs/command_variant"}], "unevaluatedProperties": false},
    "actor": {"oneOf": [{"$ref": "#/$defs/user_actor"}, {"$ref": "#/$defs/agent_actor"}, {"$ref": "#/$defs/operator_actor"}]},
    "user_actor": {"type": "object", "additionalProperties": false, "required": ["type", "user_id", "membership_revision", "auth_epoch"], "properties": {"type": {"const": "user"}, "user_id": {"$ref": "#/$defs/uuid"}, "membership_revision": {"type": "integer", "minimum": 0}, "auth_epoch": {"type": "integer", "minimum": 0}}},
    "agent_actor": {"type": "object", "additionalProperties": false, "required": ["type", "user_id", "membership_revision", "auth_epoch", "agent_id", "agent_authorization_id"], "properties": {"type": {"const": "agent"}, "user_id": {"$ref": "#/$defs/uuid"}, "membership_revision": {"type": "integer", "minimum": 0}, "auth_epoch": {"type": "integer", "minimum": 0}, "agent_id": {"$ref": "#/$defs/uuid"}, "agent_authorization_id": {"$ref": "#/$defs/uuid"}}},
    "operator_actor": {"type": "object", "additionalProperties": false, "required": ["type", "installation_operator_id", "reason"], "properties": {"type": {"const": "installation_operator"}, "installation_operator_id": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}},
    "actor_policy": {"allOf": [{"if": {"properties": {"command_name": {"enum": ["activate_bootstrap", "recover_methodologist"]}}, "required": ["command_name"]}, "then": {"properties": {"actor": {"$ref": "#/$defs/operator_actor"}, "transport": {"const": "operator"}}}, "else": {"properties": {"actor": {"oneOf": [{"$ref": "#/$defs/user_actor"}, {"$ref": "#/$defs/agent_actor"}]}}}}, {"if": {"properties": {"command_name": {"enum": ["publish_review", "grant_agent_authorization", "revoke_agent_authorization"]}}, "required": ["command_name"]}, "then": {"properties": {"actor": {"$ref": "#/$defs/user_actor"}, "transport": {"const": "rest"}}}}]},
    "application": {"allOf": [{"$ref": "#/$defs/command_core"}, {"$ref": "#/$defs/command_variant"}, {"$ref": "#/$defs/actor_policy"}, {"type": "object", "required": ["organization_id", "actor", "transport", "trace_id"], "properties": {"organization_id": {"$ref": "#/$defs/uuid"}, "actor": {"$ref": "#/$defs/actor"}, "transport": {"enum": ["rest", "mcp", "worker", "operator"]}, "trace_id": {"$ref": "#/$defs/uuid"}}}], "unevaluatedProperties": false},
    "external_identity": {"type": "object", "additionalProperties": false, "required": ["provider", "issuer", "subject"], "properties": {"provider": {"type": "string", "minLength": 1, "maxLength": 64}, "issuer": {"type": "string", "minLength": 1, "maxLength": 512}, "subject": {"type": "string", "minLength": 1, "maxLength": 512}}},
    "activate_bootstrap_payload": {"type": "object", "additionalProperties": false, "required": ["external_identity"], "properties": {"external_identity": {"$ref": "#/$defs/external_identity"}}},
    "create_invitation_payload": {"type": "object", "additionalProperties": false, "required": ["email", "role", "expires_at"], "properties": {"email": {"type": "string", "format": "email"}, "role": {"enum": ["methodologist", "reviewer"]}, "expires_at": {"type": "string", "format": "date-time"}}},
    "reason_payload": {"type": "object", "additionalProperties": false, "required": ["reason"], "properties": {"reason": {"type": "string", "minLength": 1, "maxLength": 2048}}},
    "start_course_import_payload": {"type": "object", "additionalProperties": false, "required": ["provider", "external_url"], "properties": {"provider": {"type": "string", "minLength": 1}, "external_url": {"type": "string", "format": "uri"}}},
    "change_membership_roles_payload": {"type": "object", "additionalProperties": false, "required": ["roles"], "properties": {"roles": {"type": "array", "uniqueItems": true, "items": {"enum": ["methodologist", "reviewer", "student"]}}}},
    "create_homework_payload": {"type": "object", "additionalProperties": false, "required": ["title"], "properties": {"title": {"type": "string", "minLength": 1, "maxLength": 512}}},
    "criterion_input": {"type": "object", "additionalProperties": false, "required": ["key", "title", "description", "max_points"], "properties": {"key": {"type": "string", "minLength": 1, "maxLength": 128}, "title": {"type": "string", "minLength": 1, "maxLength": 512}, "description": {"type": "string", "maxLength": 20000}, "max_points": {"type": "number", "minimum": 0}}},
    "create_homework_version_payload": {"type": "object", "additionalProperties": false, "required": ["student_text", "max_score", "artifact_kinds", "estimated_review_minutes", "criteria"], "properties": {"student_text": {"type": "string", "maxLength": 100000}, "max_score": {"type": "number", "minimum": 0}, "artifact_kinds": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["github", "google_docs"]}}, "estimated_review_minutes": {"type": "integer", "minimum": 1, "maximum": 10080}, "criteria": {"type": "array", "minItems": 1, "maxItems": 500, "items": {"$ref": "#/$defs/criterion_input"}}}},
    "publish_homework_version_payload": {"type": "object", "additionalProperties": false, "required": ["course_run_id", "submission_deadline", "review_deadline"], "properties": {"course_run_id": {"$ref": "#/$defs/uuid"}, "submission_deadline": {"type": "string", "format": "date-time"}, "review_deadline": {"type": "string", "format": "date-time"}}},
    "set_reviewer_course_selection_payload": {"type": "object", "additionalProperties": false, "required": ["course_run_ids"], "properties": {"course_run_ids": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/uuid"}}}},
    "set_reviewer_availability_payload": {"type": "object", "additionalProperties": false, "required": ["planned_minutes", "until_at"], "properties": {"planned_minutes": {"type": "integer", "minimum": 0}, "until_at": {"type": "string", "format": "date-time"}}},
    "preflight_submission_payload": {"type": "object", "additionalProperties": false, "required": ["artifact_url"], "properties": {"artifact_url": {"type": "string", "format": "uri", "maxLength": 2048}}},
    "submit_work_payload": {"type": "object", "additionalProperties": false, "required": ["artifact_reference_id"], "properties": {"artifact_reference_id": {"$ref": "#/$defs/uuid"}}},
    "open_review_iteration_payload": {"type": "object", "additionalProperties": false, "required": ["submission_version_id"], "properties": {"submission_version_id": {"$ref": "#/$defs/uuid"}}},
    "migrate_review_requirements_payload": {"type": "object", "additionalProperties": false, "required": ["homework_version_id", "criterion_set_id"], "properties": {"homework_version_id": {"$ref": "#/$defs/uuid"}, "criterion_set_id": {"$ref": "#/$defs/uuid"}}},
    "create_review_correction_payload": {"type": "object", "additionalProperties": false, "required": ["published_review_revision_id", "reason"], "properties": {"published_review_revision_id": {"$ref": "#/$defs/uuid"}, "reason": {"type": "string", "minLength": 1}}},
    "record_review_responsibility_payload": {"type": "object", "additionalProperties": false, "required": ["action"], "properties": {"action": {"enum": ["started", "joined", "released", "completed"]}}},
    "review_decision": {"type": "object", "additionalProperties": false, "required": ["criterion_id", "points", "decision", "reason"], "properties": {"criterion_id": {"$ref": "#/$defs/uuid"}, "points": {"type": "number", "minimum": 0, "description": "MUST NOT exceed max_points of the matching criterion in the ReviewIteration snapshot."}, "decision": {"enum": ["accepted", "changed", "manual"]}, "reason": {"type": "string", "minLength": 1, "maxLength": 10000}, "evidence_ids": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/uuid"}}}},
    "review_note": {"type": "object", "additionalProperties": false, "required": ["text"], "properties": {"criterion_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]}, "text": {"type": "string", "minLength": 1, "maxLength": 10000}}},
    "save_review_revision_payload": {"type": "object", "additionalProperties": false, "required": ["feedback", "criterion_decisions", "review_notes"], "properties": {"feedback": {"type": "string", "maxLength": 50000}, "criterion_decisions": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/review_decision"}}, "review_notes": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/review_note"}}}},
    "request_review_publication_payload": {"type": "object", "additionalProperties": false, "required": ["review_revision_id", "expires_at"], "properties": {"review_revision_id": {"$ref": "#/$defs/uuid"}, "expires_at": {"type": "string", "format": "date-time"}}},
    "publish_review_payload": {"type": "object", "additionalProperties": false, "required": ["review_revision_id"], "properties": {"review_revision_id": {"$ref": "#/$defs/uuid"}, "publication_request_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]}}},
    "retry_delivery_payload": {"type": "object", "additionalProperties": false, "required": ["reconcile_first"], "properties": {"reconcile_first": {"const": true}}},
    "agent_scope": {"enum": ["courses:read", "review_preferences:write", "review_queue:read", "reviews:read", "reviews:write", "ai_reviews:start", "operations:read", "publication_requests:write"]},
    "grant_agent_authorization_payload": {"type": "object", "additionalProperties": false, "required": ["agent_id", "scopes", "expires_at"], "properties": {"agent_id": {"$ref": "#/$defs/uuid"}, "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/agent_scope"}}, "expires_at": {"type": "string", "format": "date-time"}}},
    "recover_methodologist_payload": {"type": "object", "additionalProperties": false, "required": ["organization_id", "provider", "issuer", "subject", "reason"], "properties": {"organization_id": {"$ref": "#/$defs/uuid"}, "provider": {"type": "string", "minLength": 1}, "issuer": {"type": "string", "minLength": 1}, "subject": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}},
    "activate_bootstrap": {"allOf": [{"$ref": "#/$defs/wire"}, {"properties": {"command_name": {"const": "activate_bootstrap"}}}]},
    "create_invitation": {"allOf": [{"$ref": "#/$defs/wire"}, {"properties": {"command_name": {"const": "create_invitation"}}}]},
    "revoke_invitation": {"allOf": [{"$ref": "#/$defs/wire"}, {"properties": {"command_name": {"const": "revoke_invitation"}}}]},
    "start_course_import": {"allOf": [{"$ref": "#/$defs/wire"}, {"properties": {"command_name": {"const": "start_course_import"}}}]},
    "archive_course": {"allOf": [{"$ref": "#/$defs/wire"}, {"properties": {"command_name": {"const": "archive_course"}}}]},
    "restore_course": {"allOf": [{"$ref": "#/$defs/wire"}, {"properties": {"command_name": {"const": "restore_course"}}}]},
    "archive_course_run": {"allOf": [{"$ref": "#/$defs/wire"}, {"properties": {"command_name": {"const": "archive_course_run"}}}]},
    "restore_course_run": {"allOf": [{"$ref": "#/$defs/wire"}, {"properties": {"command_name": {"const": "restore_course_run"}}}]},
    "change_membership_roles": {"allOf": [{"$ref": "#/$defs/wire"}, {"properties": {"command_name": {"const": "change_membership_roles"}}}]},
    "create_homework": {"allOf": [{"$ref": "#/$defs/wire"}, {"properties": {"command_name": {"const": "create_homework"}}}]},
    "create_homework_version": {"allOf": [{"$ref": "#/$defs/wire"}, {"properties": {"command_name": {"const": "create_homework_version"}}}]},
    "publish_homework_version": {"allOf": [{"$ref": "#/$defs/wire"}, {"properties": {"command_name": {"const": "publish_homework_version"}}}]},
    "set_reviewer_course_selection": {"allOf": [{"$ref": "#/$defs/wire"}, {"properties": {"command_name": {"const": "set_reviewer_course_selection"}}}]},
    "set_reviewer_availability": {"allOf": [{"$ref": "#/$defs/wire"}, {"properties": {"command_name": {"const": "set_reviewer_availability"}}}]},
    "preflight_submission": {"allOf": [{"$ref": "#/$defs/wire"}, {"properties": {"command_name": {"const": "preflight_submission"}}}]},
    "submit_work": {"allOf": [{"$ref": "#/$defs/wire"}, {"properties": {"command_name": {"const": "submit_work"}}}]},
    "open_review_iteration": {"allOf": [{"$ref": "#/$defs/wire"}, {"properties": {"command_name": {"const": "open_review_iteration"}}}]},
    "migrate_review_requirements": {"allOf": [{"$ref": "#/$defs/wire"}, {"properties": {"command_name": {"const": "migrate_review_requirements"}}}]},
    "create_review_correction": {"allOf": [{"$ref": "#/$defs/wire"}, {"properties": {"command_name": {"const": "create_review_correction"}}}]},
    "record_review_responsibility": {"allOf": [{"$ref": "#/$defs/wire"}, {"properties": {"command_name": {"const": "record_review_responsibility"}}}]},
    "save_review_revision": {"allOf": [{"$ref": "#/$defs/wire"}, {"properties": {"command_name": {"const": "save_review_revision"}}}]},
    "request_review_publication": {"allOf": [{"$ref": "#/$defs/wire"}, {"properties": {"command_name": {"const": "request_review_publication"}}}]},
    "publish_review": {"allOf": [{"$ref": "#/$defs/wire"}, {"properties": {"command_name": {"const": "publish_review"}}}]},
    "start_ai_review": {"allOf": [{"$ref": "#/$defs/wire"}, {"properties": {"command_name": {"const": "start_ai_review"}}}]},
    "retry_delivery": {"allOf": [{"$ref": "#/$defs/wire"}, {"properties": {"command_name": {"const": "retry_delivery"}}}]},
    "grant_agent_authorization": {"allOf": [{"$ref": "#/$defs/wire"}, {"properties": {"command_name": {"const": "grant_agent_authorization"}}}]},
    "revoke_agent_authorization": {"allOf": [{"$ref": "#/$defs/wire"}, {"properties": {"command_name": {"const": "revoke_agent_authorization"}}}]},
    "recover_methodologist": {"allOf": [{"$ref": "#/$defs/wire"}, {"properties": {"command_name": {"const": "recover_methodologist"}}}]}
  },
  "$ref": "#/$defs/wire"
}

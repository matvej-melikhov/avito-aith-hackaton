# Local-only configuration. Copy to deploy/.env; do not put real credentials here.
COMPOSE_PROJECT_NAME=review-platform

MYSQL_IMAGE=mysql:8.4.11
MYSQL_DATABASE=review_platform
MYSQL_USER=review_platform
MYSQL_PASSWORD=local-dev-only
MYSQL_ROOT_PASSWORD=local-dev-root-only
MYSQL_PORT=13306

REDIS_IMAGE=redis:7.4.11-bookworm
REDIS_PORT=16379

MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_ROOT_USER=localminio
MINIO_ROOT_PASSWORD=local-minio-only
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_BUCKET=review-platform-local

MAILPIT_IMAGE=axllent/mailpit:v1.31.0
MAILPIT_SMTP_PORT=11025
MAILPIT_HTTP_PORT=18025

API_PORT=18000
MCP_PORT=18001

REVIEW_PLATFORM_ENVIRONMENT=local
REVIEW_PLATFORM_CONTRACT_VERSION=1.1.0
REVIEW_PLATFORM_LIVE_PROVIDERS_ENABLED=false
REVIEW_PLATFORM_DATABASE_URL=mysql+asyncmy://review_platform:local-dev-only@mysql:3306/review_platform
REVIEW_PLATFORM_REDIS_URL=redis://redis:6379/0
REVIEW_PLATFORM_S3_ENDPOINT_URL=http://minio:9000
REVIEW_PLATFORM_S3_BUCKET=review-platform-local
REVIEW_PLATFORM_CREDENTIAL_ENCRYPTION_KEY_REF=local-keyring:review-platform

REVIEW_PLATFORM_COMMAND_BODY_LIMIT_BYTES=1048576
REVIEW_PLATFORM_PROVIDER_TIMEOUT_SECONDS=15
REVIEW_PLATFORM_PROVIDER_MAX_ATTEMPTS=5
REVIEW_PLATFORM_RETRY_INITIAL_SECONDS=60
REVIEW_PLATFORM_RETRY_MAX_SECONDS=3600
REVIEW_PLATFORM_COURSE_IMPORT_CONCURRENCY=2
REVIEW_PLATFORM_AI_REVIEW_CONCURRENCY=10
REVIEW_PLATFORM_DELIVERY_CONCURRENCY=20

REVIEW_PLATFORM_GITHUB_MAX_FILES=10000
REVIEW_PLATFORM_SINGLE_BLOB_MAX_BYTES=10485760
REVIEW_PLATFORM_ARTIFACT_TOTAL_MAX_BYTES=104857600
REVIEW_PLATFORM_ARCHIVE_MAX_BYTES=104857600
REVIEW_PLATFORM_UNPACKED_MAX_BYTES=262144000
REVIEW_PLATFORM_GOOGLE_DOCX_MAX_BYTES=10000000
REVIEW_PLATFORM_AI_SIGNED_URL_TTL_SECONDS=900

REVIEW_PLATFORM_ARTIFACT_BYTES_RETENTION_DAYS=90
REVIEW_PLATFORM_HISTORY_RETENTION_DAYS=365
REVIEW_PLATFORM_OPERATION_RETENTION_DAYS=90
REVIEW_PLATFORM_LOG_RETENTION_DAYS=30

REVIEW_PLATFORM_STEPIK_SANDBOX_ENABLED=false
REVIEW_PLATFORM_GITHUB_SANDBOX_ENABLED=false
REVIEW_PLATFORM_GOOGLE_DOCS_SANDBOX_ENABLED=false
REVIEW_PLATFORM_EMAIL_SANDBOX_ENABLED=false

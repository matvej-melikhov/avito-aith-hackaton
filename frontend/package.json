{
  "name": "review-platform-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost",
    "dev:demo": "vite --host localhost --mode demo",
    "generate:api": "node scripts/generate-api.mjs && node scripts/generate-workspace.mjs",
    "check:api": "node scripts/generate-api.mjs --check && node scripts/generate-workspace.mjs --check",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview --host localhost",
    "format": "prettier --write src scripts tests vite.config.ts",
    "format:check": "prettier --check src scripts tests vite.config.ts"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsdom": "30.0.1",
    "json-schema-to-typescript": "16.0.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "yaml": "2.9.0"
  }
}

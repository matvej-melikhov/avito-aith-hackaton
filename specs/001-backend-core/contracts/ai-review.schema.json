{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:review-platform:ai-review:1.0.0",
  "x-contract-status": "frozen",
  "title": "AIReviewContract",
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "key",
        "title",
        "description",
        "max_points"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "max_points": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "quote"
      ],
      "properties": {
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        }
      }
    },
    "suggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "status",
        "proposed_points",
        "reason",
        "evidence",
        "confidence",
        "flags"
      ],
      "properties": {
        "criterion_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "enum": [
            "suggested",
            "needs_human",
            "not_checked"
          ]
        },
        "proposed_points": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "reason": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "reviewer_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "student_feedback": {
          "type": [
            "string",
            "null"
          ]
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_checked"
              }
            }
          },
          "then": {
            "properties": {
              "proposed_points": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "run_id",
        "input_fingerprint",
        "fingerprint_algorithm",
        "organization_id",
        "review_iteration_id",
        "artifact",
        "artifact_download",
        "homework",
        "criteria"
      ],
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "input_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "fingerprint_algorithm": {
          "const": "jcs-sha256-v1"
        },
        "organization_id": {
          "type": "string",
          "format": "uuid"
        },
        "review_iteration_id": {
          "type": "string",
          "format": "uuid"
        },
        "artifact": {
          "$ref": "artifact.schema.json"
        },
        "artifact_download": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "expires_at"
          ],
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "homework": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version_id",
            "title",
            "student_text",
            "digest"
          ],
          "properties": {
            "version_id": {
              "type": "string",
              "format": "uuid"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "student_text": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "criteria": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "set_id",
            "digest",
            "items"
          ],
          "properties": {
            "set_id": {
              "type": "string",
              "format": "uuid"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/criterion"
              }
            }
          }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "run_id",
        "attempt_id",
        "attempt_number",
        "event_id",
        "sequence",
        "input_fingerprint",
        "status",
        "is_final",
        "suggestions"
      ],
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "attempt_id": {
          "type": "string",
          "format": "uuid"
        },
        "attempt_number": {
          "type": "integer",
          "minimum": 1
        },
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "input_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "status": {
          "enum": [
            "running",
            "partial",
            "succeeded",
            "retryable_failed",
            "action_required"
          ]
        },
        "is_final": {
          "type": "boolean"
        },
        "suggestions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/suggestion"
          }
        },
        "ai_signal": {
          "oneOf": [
            {
              "$ref": "#/$defs/aiSignal"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "oneOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "succeeded",
                  "retryable_failed",
                  "action_required"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "is_final": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "running",
                  "partial"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "is_final": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "aiSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "evidence",
        "limitations"
      ],
      "properties": {
        "level": {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "insufficient_data"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/event"
    }
  ]
}

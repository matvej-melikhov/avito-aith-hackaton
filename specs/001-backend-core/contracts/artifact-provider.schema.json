{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:review-platform:artifact-provider:1.1.0",
  "x-contract-status": "candidate",
  "title": "ArtifactProviderContract",
  "oneOf": [{"$ref": "#/$defs/preflight_request"}, {"$ref": "#/$defs/preflight_result"}, {"$ref": "#/$defs/capture_request"}, {"$ref": "#/$defs/capture_result"}],
  "$defs": {
    "error": {"type": "object", "additionalProperties": false, "required": ["code", "message", "retryable"], "properties": {"code": {"type": "string", "minLength": 1, "maxLength": 128}, "message": {"type": "string", "maxLength": 2048}, "retryable": {"type": "boolean"}, "action": {"type": ["string", "null"], "maxLength": 512}}},
    "locator": {"type": "object", "additionalProperties": false, "required": ["canonical_url", "external_id"], "properties": {"canonical_url": {"type": "string", "format": "uri", "maxLength": 2048}, "external_id": {"type": "string", "minLength": 1, "maxLength": 512}}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_files", "max_single_blob_bytes", "max_total_bytes", "max_archive_bytes", "max_unpacked_bytes"], "properties": {"max_files": {"type": "integer", "minimum": 1}, "max_single_blob_bytes": {"type": "integer", "minimum": 1}, "max_total_bytes": {"type": "integer", "minimum": 1}, "max_archive_bytes": {"type": "integer", "minimum": 1}, "max_unpacked_bytes": {"type": "integer", "minimum": 1}}},
    "preflight_request": {"type": "object", "additionalProperties": false, "required": ["contract_version", "organization_id", "provider", "url", "credential_binding_id", "credential_binding_version"], "properties": {"contract_version": {"const": "1.1.0"}, "organization_id": {"type": "string", "format": "uuid"}, "provider": {"enum": ["github", "google_docs"]}, "url": {"type": "string", "format": "uri", "maxLength": 2048}, "credential_binding_id": {"type": "string", "format": "uuid"}, "credential_binding_version": {"type": "integer", "minimum": 1}}},
    "preflight_result": {"type": "object", "additionalProperties": false, "required": ["contract_version", "organization_id", "provider", "read_capability", "feedback_capability", "locator", "error"], "properties": {"contract_version": {"const": "1.1.0"}, "organization_id": {"type": "string", "format": "uuid"}, "provider": {"enum": ["github", "google_docs"]}, "read_capability": {"enum": ["available", "requires_action", "unavailable"]}, "feedback_capability": {"enum": ["available", "not_supported", "requires_action"]}, "locator": {"oneOf": [{"$ref": "#/$defs/locator"}, {"type": "null"}]}, "error": {"oneOf": [{"$ref": "#/$defs/error"}, {"type": "null"}]}}, "allOf": [{"if": {"properties": {"read_capability": {"const": "available"}}}, "then": {"properties": {"locator": {"$ref": "#/$defs/locator"}, "error": {"type": "null"}}}, "else": {"properties": {"locator": {"type": "null"}, "error": {"$ref": "#/$defs/error"}}}}]},
    "capture_request": {"type": "object", "additionalProperties": false, "required": ["contract_version", "organization_id", "artifact_reference_id", "provider", "locator", "credential_binding_id", "credential_binding_version", "limits"], "properties": {"contract_version": {"const": "1.1.0"}, "organization_id": {"type": "string", "format": "uuid"}, "artifact_reference_id": {"type": "string", "format": "uuid"}, "provider": {"enum": ["github", "google_docs"]}, "locator": {"$ref": "#/$defs/locator"}, "credential_binding_id": {"type": "string", "format": "uuid"}, "credential_binding_version": {"type": "integer", "minimum": 1}, "limits": {"$ref": "#/$defs/limits"}}},
    "capture_result": {"type": "object", "additionalProperties": false, "required": ["contract_version", "organization_id", "artifact_reference_id", "outcome", "provider_version", "content", "error"], "properties": {"contract_version": {"const": "1.1.0"}, "organization_id": {"type": "string", "format": "uuid"}, "artifact_reference_id": {"type": "string", "format": "uuid"}, "outcome": {"enum": ["succeeded", "failed"]}, "provider_version": {"type": "string", "minLength": 1, "maxLength": 256}, "content": {"type": ["object", "null"], "additionalProperties": false, "required": ["download_url", "media_type", "byte_size", "content_digest"], "properties": {"download_url": {"type": "string", "format": "uri", "maxLength": 2048}, "media_type": {"type": "string", "minLength": 1, "maxLength": 255}, "byte_size": {"type": "integer", "minimum": 1}, "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}, "error": {"oneOf": [{"$ref": "#/$defs/error"}, {"type": "null"}]}}, "allOf": [{"if": {"properties": {"outcome": {"const": "succeeded"}}}, "then": {"properties": {"content": {"type": "object"}, "error": {"type": "null"}}}, "else": {"properties": {"content": {"type": "null"}, "error": {"$ref": "#/$defs/error"}}}}]}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:review-platform:course-import:1.1.0",
  "x-contract-status": "frozen",
  "title": "CourseImportProviderContract",
  "oneOf": [{"$ref": "#/$defs/request"}, {"$ref": "#/$defs/result"}],
  "$defs": {
    "error": {"type": "object", "additionalProperties": false, "required": ["code", "message", "retryable"], "properties": {"code": {"type": "string", "minLength": 1, "maxLength": 128}, "message": {"type": "string", "maxLength": 2048}, "retryable": {"type": "boolean"}, "action": {"type": ["string", "null"], "maxLength": 512}}},
    "course_run": {"type": "object", "additionalProperties": false, "required": ["external_run_id", "title", "timezone", "status"], "properties": {"external_run_id": {"type": "string", "minLength": 1, "maxLength": 256}, "title": {"type": "string", "minLength": 1, "maxLength": 512}, "timezone": {"type": "string", "minLength": 1, "maxLength": 64}, "starts_at": {"type": ["string", "null"], "format": "date-time"}, "ends_at": {"type": ["string", "null"], "format": "date-time"}, "status": {"enum": ["draft", "active", "archived"]}}},
    "course": {"type": "object", "additionalProperties": false, "required": ["external_course_id", "title", "runs"], "properties": {"external_course_id": {"type": "string", "minLength": 1, "maxLength": 256}, "title": {"type": "string", "minLength": 1, "maxLength": 512}, "description": {"type": "string", "maxLength": 20000}, "runs": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/course_run"}}}},
    "membership": {"type": "object", "additionalProperties": false, "required": ["external_run_id", "external_user_id", "display_name", "kind", "status"], "properties": {"external_run_id": {"type": "string", "minLength": 1, "maxLength": 256}, "external_user_id": {"type": "string", "minLength": 1, "maxLength": 256}, "display_name": {"type": "string", "minLength": 1, "maxLength": 512}, "verified_email": {"type": ["string", "null"], "format": "email", "maxLength": 320}, "kind": {"const": "student"}, "status": {"enum": ["active", "removed"]}}},
    "request": {"type": "object", "additionalProperties": false, "required": ["contract_version", "organization_id", "operation_id", "credential_binding_id", "credential_binding_version", "provider", "external_url", "page_size"], "properties": {"contract_version": {"const": "1.1.0"}, "organization_id": {"type": "string", "format": "uuid"}, "operation_id": {"type": "string", "format": "uuid"}, "credential_binding_id": {"type": "string", "format": "uuid"}, "credential_binding_version": {"type": "integer", "minimum": 1}, "provider": {"const": "stepik"}, "external_url": {"type": "string", "format": "uri", "maxLength": 2048}, "cursor": {"type": ["string", "null"], "maxLength": 512}, "page_size": {"type": "integer", "minimum": 1, "maximum": 1000}}},
    "result": {"type": "object", "additionalProperties": false, "required": ["contract_version", "organization_id", "operation_id", "provider_version", "outcome", "course", "memberships", "complete", "next_cursor", "error"], "properties": {"contract_version": {"const": "1.1.0"}, "organization_id": {"type": "string", "format": "uuid"}, "operation_id": {"type": "string", "format": "uuid"}, "provider_version": {"type": "string", "minLength": 1, "maxLength": 128}, "outcome": {"enum": ["succeeded", "partial", "failed"]}, "course": {"oneOf": [{"$ref": "#/$defs/course"}, {"type": "null"}]}, "memberships": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/membership"}}, "complete": {"type": "boolean"}, "next_cursor": {"type": ["string", "null"], "maxLength": 512}, "error": {"oneOf": [{"$ref": "#/$defs/error"}, {"type": "null"}]}}, "allOf": [{"if": {"properties": {"outcome": {"const": "failed"}}}, "then": {"properties": {"course": {"type": "null"}, "memberships": {"maxItems": 0}, "error": {"$ref": "#/$defs/error"}}}, "else": {"properties": {"course": {"$ref": "#/$defs/course"}, "error": {"type": "null"}}}}]}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:review-platform:delivery:1.1.0",
  "x-contract-status": "candidate",
  "title": "ExternalDeliveryProviderContract",
  "oneOf": [{"$ref": "#/$defs/deliver_request"}, {"$ref": "#/$defs/reconcile_request"}, {"$ref": "#/$defs/result"}],
  "$defs": {
    "error": {"type": "object", "additionalProperties": false, "required": ["code", "message", "retryable"], "properties": {"code": {"type": "string", "minLength": 1, "maxLength": 128}, "message": {"type": "string", "maxLength": 2048}, "retryable": {"type": "boolean"}, "action": {"type": ["string", "null"], "maxLength": 512}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["course_run_id", "homework_version_id", "criterion_set_id", "submission_version_id", "artifact_version_id", "artifact_content_digest", "review_iteration_id", "review_revision_id", "contract_version"], "properties": {"course_run_id": {"type": "string", "format": "uuid"}, "homework_version_id": {"type": "string", "format": "uuid"}, "criterion_set_id": {"type": "string", "format": "uuid"}, "submission_version_id": {"type": "string", "format": "uuid"}, "artifact_version_id": {"type": "string", "format": "uuid"}, "artifact_content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "review_iteration_id": {"type": "string", "format": "uuid"}, "review_revision_id": {"type": "string", "format": "uuid"}, "contract_version": {"const": "1.1.0"}}},
    "criterion_result": {"type": "object", "additionalProperties": false, "required": ["criterion_id", "points", "reason"], "properties": {"criterion_id": {"type": "string", "format": "uuid"}, "points": {"type": "number", "minimum": 0}, "reason": {"type": "string", "minLength": 1, "maxLength": 10000}}},
    "payload": {"type": "object", "additionalProperties": false, "required": ["total_score", "feedback", "criteria"], "properties": {"total_score": {"type": "number", "minimum": 0}, "feedback": {"type": "string", "maxLength": 50000}, "criteria": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/criterion_result"}}}},
    "deliver_request": {"type": "object", "additionalProperties": false, "required": ["contract_version", "organization_id", "delivery_id", "delivery_key", "destination", "provenance", "publication_fingerprint", "payload_digest", "payload"], "properties": {"contract_version": {"const": "1.1.0"}, "organization_id": {"type": "string", "format": "uuid"}, "delivery_id": {"type": "string", "format": "uuid"}, "delivery_key": {"type": "string", "minLength": 1, "maxLength": 512}, "destination": {"type": "object", "additionalProperties": false, "required": ["binding_id", "binding_version", "credential_binding_id", "credential_binding_version", "kind", "recipient_ref"], "properties": {"binding_id": {"type": "string", "format": "uuid"}, "binding_version": {"type": "integer", "minimum": 1}, "credential_binding_id": {"type": "string", "format": "uuid"}, "credential_binding_version": {"type": "integer", "minimum": 1}, "kind": {"enum": ["stepik", "github"]}, "recipient_ref": {"type": "string", "minLength": 1, "maxLength": 512}}}, "provenance": {"$ref": "#/$defs/provenance"}, "publication_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "payload_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "payload": {"$ref": "#/$defs/payload"}}},
    "reconcile_request": {"type": "object", "additionalProperties": false, "required": ["contract_version", "organization_id", "delivery_id", "delivery_key", "destination_binding_id", "destination_binding_version", "credential_binding_id", "credential_binding_version", "payload_digest"], "properties": {"contract_version": {"const": "1.1.0"}, "organization_id": {"type": "string", "format": "uuid"}, "delivery_id": {"type": "string", "format": "uuid"}, "delivery_key": {"type": "string", "minLength": 1, "maxLength": 512}, "destination_binding_id": {"type": "string", "format": "uuid"}, "destination_binding_version": {"type": "integer", "minimum": 1}, "credential_binding_id": {"type": "string", "format": "uuid"}, "credential_binding_version": {"type": "integer", "minimum": 1}, "payload_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "result": {"type": "object", "additionalProperties": false, "required": ["contract_version", "organization_id", "delivery_id", "outcome", "external_id", "external_url", "error"], "properties": {"contract_version": {"const": "1.1.0"}, "organization_id": {"type": "string", "format": "uuid"}, "delivery_id": {"type": "string", "format": "uuid"}, "outcome": {"enum": ["succeeded", "retryable_failed", "unknown_outcome", "action_required", "not_found"]}, "external_id": {"type": ["string", "null"], "maxLength": 512}, "external_url": {"type": ["string", "null"], "format": "uri", "maxLength": 2048}, "error": {"oneOf": [{"$ref": "#/$defs/error"}, {"type": "null"}]}}, "allOf": [{"if": {"properties": {"outcome": {"const": "succeeded"}}}, "then": {"properties": {"external_id": {"type": "string", "minLength": 1}, "error": {"type": "null"}}}, "else": {"properties": {"error": {"$ref": "#/$defs/error"}}}}]}
  }
}

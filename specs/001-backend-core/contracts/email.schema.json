{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:review-platform:email:1.1.0",
  "x-contract-status": "candidate",
  "title": "EmailProviderContract",
  "oneOf": [{"$ref": "#/$defs/send_request"}, {"$ref": "#/$defs/send_result"}],
  "$defs": {
    "error": {"type": "object", "additionalProperties": false, "required": ["code", "message", "retryable"], "properties": {"code": {"type": "string", "minLength": 1, "maxLength": 128}, "message": {"type": "string", "maxLength": 2048}, "retryable": {"type": "boolean"}, "action": {"type": ["string", "null"], "maxLength": 512}}},
    "template_data": {"type": "object", "additionalProperties": false, "required": ["invitation_id", "magic_link_url", "expires_at"], "properties": {"invitation_id": {"type": "string", "format": "uuid"}, "magic_link_url": {"type": "string", "format": "uri", "maxLength": 2048}, "expires_at": {"type": "string", "format": "date-time"}}},
    "send_request": {"type": "object", "additionalProperties": false, "required": ["contract_version", "organization_id", "message_id", "credential_binding_id", "credential_binding_version", "template", "recipient", "template_data"], "properties": {"contract_version": {"const": "1.1.0"}, "organization_id": {"type": "string", "format": "uuid"}, "message_id": {"type": "string", "format": "uuid"}, "credential_binding_id": {"type": "string", "format": "uuid"}, "credential_binding_version": {"type": "integer", "minimum": 1}, "template": {"const": "reviewer_magic_link"}, "recipient": {"type": "string", "format": "email", "maxLength": 320}, "template_data": {"$ref": "#/$defs/template_data"}}},
    "send_result": {"type": "object", "additionalProperties": false, "required": ["contract_version", "organization_id", "message_id", "outcome", "provider_message_id", "error"], "properties": {"contract_version": {"const": "1.1.0"}, "organization_id": {"type": "string", "format": "uuid"}, "message_id": {"type": "string", "format": "uuid"}, "outcome": {"enum": ["accepted", "retryable_failed", "action_required"]}, "provider_message_id": {"type": ["string", "null"], "maxLength": 512}, "error": {"oneOf": [{"$ref": "#/$defs/error"}, {"type": "null"}]}}, "allOf": [{"if": {"properties": {"outcome": {"const": "accepted"}}}, "then": {"properties": {"provider_message_id": {"type": "string", "minLength": 1}, "error": {"type": "null"}}}, "else": {"properties": {"error": {"$ref": "#/$defs/error"}}}}]}
  }
}

{
  "contractVersion": "1.1.0",
  "contractStatus": "frozen",
  "protocolVersion": "2026-07-28",
  "transport": {
    "kind": "stateless-http",
    "path": "/mcp",
    "requiredHeaders": ["MCP-Protocol-Version", "Mcp-Method", "Mcp-Name"],
    "authorization": "bearer"
  },
  "rules": {
    "actorFromAuthorization": true,
    "organizationFromAuthorization": true,
    "wireCommandSchema": "command.schema.json#/$defs/wire",
    "sameApplicationCommandsAsRest": true,
    "directPublicationAllowed": false,
    "unknownScopesRejected": true
  },
  "tools": [
    {
      "name": "list_courses",
      "mode": "read",
      "requiredRoles": ["reviewer", "methodologist"],
      "requiredScopes": ["courses:read"],
      "restOperationId": "listCourses",
      "inputSchema": {"type": "object", "additionalProperties": false, "properties": {}},
      "outputSchema": {"$ref": "openapi.yaml#/components/schemas/CourseList"}
    },
    {
      "name": "select_reviewer_courses",
      "mode": "write",
      "requiredRoles": ["reviewer"],
      "requiredScopes": ["review_preferences:write"],
      "restOperationId": "setReviewerCourseSelection",
      "inputSchema": {"$ref": "command.schema.json#/$defs/set_reviewer_course_selection"},
      "outputSchema": {"$ref": "#/$defs/ack"}
    },
    {
      "name": "set_availability",
      "mode": "write",
      "requiredRoles": ["reviewer"],
      "requiredScopes": ["review_preferences:write"],
      "restOperationId": "setReviewerAvailability",
      "inputSchema": {"$ref": "command.schema.json#/$defs/set_reviewer_availability"},
      "outputSchema": {"$ref": "#/$defs/ack"}
    },
    {
      "name": "recommend_next_review",
      "mode": "read",
      "requiredRoles": ["reviewer"],
      "requiredScopes": ["review_queue:read"],
      "restOperationId": "recommendNextReview",
      "inputSchema": {"type": "object", "additionalProperties": false, "required": ["course_run_id"], "properties": {"course_run_id": {"type": "string", "format": "uuid"}}},
      "outputSchema": {"$ref": "#/$defs/recommendation"}
    },
    {
      "name": "get_review_iteration",
      "mode": "read",
      "requiredRoles": ["reviewer", "methodologist"],
      "requiredScopes": ["reviews:read"],
      "restOperationId": "getReviewIteration",
      "inputSchema": {"type": "object", "additionalProperties": false, "required": ["review_iteration_id"], "properties": {"review_iteration_id": {"type": "string", "format": "uuid"}}},
      "outputSchema": {"$ref": "openapi.yaml#/components/schemas/ReviewDetail"}
    },
    {
      "name": "open_review_iteration",
      "mode": "write",
      "requiredRoles": ["reviewer", "methodologist"],
      "requiredScopes": ["reviews:write"],
      "restOperationId": "openReviewIteration",
      "inputSchema": {"$ref": "command.schema.json#/$defs/open_review_iteration"},
      "outputSchema": {"$ref": "openapi.yaml#/components/schemas/ReviewIterationCreated"}
    },
    {
      "name": "record_review_responsibility",
      "mode": "write",
      "requiredRoles": ["reviewer", "methodologist"],
      "requiredScopes": ["reviews:write"],
      "restOperationId": "recordReviewResponsibility",
      "inputSchema": {"$ref": "command.schema.json#/$defs/record_review_responsibility"},
      "outputSchema": {"$ref": "#/$defs/ack"}
    },
    {
      "name": "save_review_revision",
      "mode": "write",
      "requiredRoles": ["reviewer", "methodologist"],
      "requiredScopes": ["reviews:write"],
      "restOperationId": "saveReviewRevision",
      "inputSchema": {"$ref": "command.schema.json#/$defs/save_review_revision"},
      "outputSchema": {"$ref": "openapi.yaml#/components/schemas/ReviewRevisionSaved"}
    },
    {
      "name": "start_ai_review",
      "mode": "write",
      "requiredRoles": ["reviewer", "methodologist"],
      "requiredScopes": ["ai_reviews:start"],
      "restOperationId": "startAIReview",
      "inputSchema": {"$ref": "command.schema.json#/$defs/start_ai_review"},
      "outputSchema": {"$ref": "openapi.yaml#/components/schemas/Operation"}
    },
    {
      "name": "get_operation",
      "mode": "read",
      "requiredRoles": ["reviewer", "methodologist"],
      "requiredScopes": ["operations:read"],
      "restOperationId": "getOperation",
      "inputSchema": {"type": "object", "additionalProperties": false, "required": ["operation_id"], "properties": {"operation_id": {"type": "string", "format": "uuid"}}},
      "outputSchema": {"$ref": "openapi.yaml#/components/schemas/Operation"}
    },
    {
      "name": "request_review_publication",
      "mode": "write",
      "requiredRoles": ["reviewer", "methodologist"],
      "requiredScopes": ["publication_requests:write"],
      "restOperationId": "requestReviewPublication",
      "inputSchema": {"$ref": "command.schema.json#/$defs/request_review_publication"},
      "outputSchema": {"$ref": "openapi.yaml#/components/schemas/PublicationRequest"}
    },
    {
      "name": "get_homework_history",
      "mode": "read",
      "requiredRoles": ["reviewer", "methodologist"],
      "requiredScopes": ["courses:read"],
      "restOperationId": "getHomeworkHistory",
      "inputSchema": {"type": "object", "additionalProperties": false, "required": ["homework_id"], "properties": {"homework_id": {"type": "string", "format": "uuid"}}},
      "outputSchema": {"$ref": "openapi.yaml#/components/schemas/HomeworkHistory"}
    }
  ],
  "audit": {
    "required": ["request_id", "trace_id", "tool_name", "actor_user_id", "agent_id", "agent_authorization_id", "outcome", "duration_ms", "idempotency_disposition"]
  },
  "$defs": {
    "ack": {"type": "object", "additionalProperties": false, "required": ["ok", "entity_id", "revision"], "properties": {"ok": {"const": true}, "entity_id": {"type": "string", "format": "uuid"}, "revision": {"type": "integer", "minimum": 0}}},
    "recommendation": {"type": "object", "additionalProperties": false, "required": ["ok", "review_case_id", "review_case_revision", "submission_version_id", "reason"], "properties": {"ok": {"const": true}, "review_case_id": {"type": ["string", "null"], "format": "uuid"}, "review_case_revision": {"type": ["integer", "null"], "minimum": 0}, "submission_version_id": {"type": ["string", "null"], "format": "uuid"}, "reason": {"type": "array", "items": {"type": "string"}}}, "allOf": [{"if": {"properties": {"review_case_id": {"type": "null"}}}, "then": {"properties": {"review_case_revision": {"type": "null"}, "submission_version_id": {"type": "null"}}}, "else": {"properties": {"review_case_revision": {"type": "integer"}, "submission_version_id": {"type": "string", "format": "uuid"}}}}]}
  }
}

{
  "$defs": {
    "AssistEvidence": {
      "additionalProperties": false,
      "properties": {
        "line_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "line_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "locator": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "quote": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "verified": {
          "const": false,
          "default": false,
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "quote"
      ],
      "title": "AssistEvidence",
      "type": "object"
    },
    "AuthorshipSignal": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/AssistEvidence"
          },
          "maxItems": 50,
          "title": "Evidence",
          "type": "array"
        },
        "explanation": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "probability": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Probability"
        }
      },
      "required": [
        "id",
        "explanation"
      ],
      "title": "AuthorshipSignal",
      "type": "object"
    },
    "ReviewAssistResult": {
      "additionalProperties": false,
      "properties": {
        "authorship_signal": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuthorshipSignal"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "feedback_draft": {
          "anyOf": [
            {
              "maxLength": 20000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feedback Draft"
        },
        "suggestions": {
          "items": {
            "$ref": "#/$defs/ReviewerSuggestion"
          },
          "maxItems": 500,
          "minItems": 1,
          "title": "Suggestions",
          "type": "array"
        }
      },
      "required": [
        "suggestions"
      ],
      "title": "ReviewAssistResult",
      "type": "object"
    },
    "ReviewerSuggestion": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "default": "medium",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "criterion_id": {
          "format": "uuid",
          "title": "Criterion Id",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Evidence",
          "type": "array"
        },
        "proposed_points": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Proposed Points"
        },
        "reason": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "requirement_met": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requirement Met"
        },
        "reviewer_note": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer Note"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/AssistEvidence"
          },
          "maxItems": 50,
          "title": "Sources",
          "type": "array"
        },
        "status": {
          "enum": [
            "suggested",
            "needs_human",
            "not_checked"
          ],
          "title": "Status",
          "type": "string"
        },
        "student_feedback": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Student Feedback"
        }
      },
      "required": [
        "criterion_id",
        "status",
        "proposed_points",
        "reason"
      ],
      "title": "ReviewerSuggestion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "contract_version": {
      "const": "2.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "error_code": {
      "anyOf": [
        {
          "enum": [
            "unavailable",
            "invalid_artifact",
            "unsupported_format",
            "invalid_result"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "input_fingerprint": {
      "title": "Input Fingerprint",
      "type": "string"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReviewAssistResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "status": {
      "enum": [
        "running",
        "succeeded",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "contract_version",
    "event_id",
    "run_id",
    "attempt",
    "sequence",
    "input_fingerprint",
    "status"
  ],
  "title": "ReviewAssistEvent",
  "type": "object"
}
